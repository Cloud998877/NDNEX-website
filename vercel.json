{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "ndnex-website-fxju.vercel.app/#/" }
      ],
      "destination": "https://ndnex.com/:path*",
      "permanent": true
    }
  ]
}


{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
